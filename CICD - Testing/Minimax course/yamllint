# yamllint config
extends: default
rules:
  line-length:
    max: 120
    level: warning
  document-start: disable   # don't require "---" at start of every file
  truthy:
    check-keys: false       # GitHub Actions uses 'on:' which is truthy
  comments:
    min-spaces-from-content: 1
  indentation:
    spaces: 2
    indent-sequences: consistent
