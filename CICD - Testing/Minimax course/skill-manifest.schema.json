{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://your-domain.com/schemas/skill-manifest.schema.json",
  "title": "Skill Manifest",
  "description": "Required metadata for every skill in the skills/ or agents/ directory",
  "type": "object",
  "required": ["name", "version", "description", "inputs", "outputs", "entry_point"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "description": "Unique kebab-case skill name. Must be unique across the entire repo."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Semantic version (semver). e.g. 1.0.0, 2.3.1-beta.1"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "One-sentence description of what the skill does."
    },
    "author": {
      "type": "string",
      "description": "Skill author (person or team name)."
    },
    "requires": {
      "type": "object",
      "description": "Version constraints for the agent that will run this skill.",
      "properties": {
        "agent_version": {
          "type": "string",
          "pattern": "^\\^?\\d+\\.\\d+\\.\\d+$",
          "description": "Semver range for required agent version."
        }
      }
    },
    "inputs": {
      "type": "object",
      "description": "JSON Schema describing the input this skill accepts.",
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "description": "JSON Schema describing the output this skill produces.",
      "additionalProperties": true
    },
    "entry_point": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_/.-]+\\.py$",
      "description": "Path to the Python file that implements this skill (relative to the skill's directory)."
    },
    "examples": {
      "type": "array",
      "description": "Sample inputs/outputs used in tests and docs.",
      "items": {
        "type": "object",
        "required": ["input", "output"],
        "properties": {
          "input": { "type": "object" },
          "output": { "type": "object" }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Free-form tags for discoverability."
    }
  }
}
