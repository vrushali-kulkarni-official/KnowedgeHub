# Copy this file to `.env` and fill it in. NEVER commit the real .env.
# Add `.env` to your .gitignore.

PORT=3000

# Which browser origins may read your API (comma separated).
# NEVER use * together with credentials — the browser rejects it.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Shared secret used to sign/verify webhook payloads.
# Generate a real one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=dev-secret-change-me
