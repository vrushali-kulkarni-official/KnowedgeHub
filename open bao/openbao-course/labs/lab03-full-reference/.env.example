# ─────────────────────────────────────────────────────────────────
#  Copy to .env and fill in. NEVER COMMIT .env
# ─────────────────────────────────────────────────────────────────

# Keycloak bootstrap admin
KC_ADMIN=admin
KC_ADMIN_PASSWORD=change-me-keycloak

# PostgreSQL (superuser) and OpenBao's dynamic-credential account
POSTGRES_PASSWORD=change-me-postgres
PG_ADMIN_PASSWORD=change-me-openbao-admin

# Redis
REDIS_PASSWORD=change-me-redis

# Keycloak → OpenBao client secret (must match keycloak/realm.json)
KEYCLOAK_CLIENT_SECRET=change-me-openbao-client-secret

# OpenBao AppRole (written by bootstrap.sh)
APPROLE_ROLE_ID=
APPROLE_SECRET_ID=
