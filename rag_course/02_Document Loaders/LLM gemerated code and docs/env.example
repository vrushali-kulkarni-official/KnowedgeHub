# Not required for Module 2 (loaders), but copy this file to .env now
# so the same .env works for later modules that need the LLM.

# Free Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: free GitHub PAT to enable the GithubFileLoader demo.
# https://github.com/settings/tokens  (no scopes needed for public repos)
GITHUB_TOKEN=
