# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Every example auto-loads `.env` from the repo root.
# ---------------------------------------------------------------------------

# Gemini via the Gemini Developer API (https://aistudio.google.com/apikey)
# If this is NOT set, the course falls back to a deterministic OFFLINE model so
# every example still runs with zero network access. You will see a banner
# telling you which mode you are in.
GOOGLE_API_KEY=

# Optional: Langfuse tracing (free tier at https://cloud.langfuse.com).
# The course also works with a fully local Langfuse (docker compose up).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: LangSmith (only needed for LangSmith Studio in M53).
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
