# --- PostgreSQL (required by 10 of the 19 examples) -------------------------
LANGGRAPH_PG_URL=postgresql://langgraph:langgraph@127.0.0.1:5432/langgraph
LANGGRAPH_PG_URL_TEST=postgresql://langgraph:langgraph@127.0.0.1:5432/langgraph_test

# --- Redis (only for ex04, the community Redis checkpointer) ---------------
# NOTE: RedisSaver needs Redis STACK (RedisJSON + RediSearch), not plain redis.
LANGGRAPH_REDIS_URL=redis://localhost:6379/0

# --- Gemini (only if you swap the scripted model for a real one) ------------
GOOGLE_API_KEY=

# --- Langfuse (only for tracing / the GDPR delete of traces) ---------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
